# Basispfad fuer den Vite-Build. Auf GitHub Pages muss hier /<reponame>/ stehen,
# lokal reicht "/". Der Deployment-Workflow setzt den Wert selbst.
VITE_BASE_PATH=/

# ---------------------------------------------------------------------------
# TURN-Server (metered.ca / Open Relay Project)
# ---------------------------------------------------------------------------
# Ohne diese Werte laeuft das Spiel normal weiter - es gelten dann die
# oeffentlichen Open-Relay-Zugangsdaten aus src/net/peerConfig.ts. Mit eigenem
# Schluessel bekommt man ein eigenes Kontingent statt eines geteilten.
#
# ACHTUNG, UND ES KLINGT ANDERS ALS ES IST: Dieser Schluessel ist in der
# ausgelieferten App NICHT geheim. Vite setzt jeden VITE_*-Wert beim Bauen fest
# in das JavaScript ein, das an die Handys geht. Holdout ist eine statische
# Seite ohne eigenen Server - es gibt keinen Ort, an dem ein Geheimnis bleiben
# koennte. Was .env bringt: Der Schluessel landet nicht in der Git-Historie,
# und er laesst sich beim Anbieter zurueckziehen und ersetzen.
#
# Deshalb: nur einen Schluessel mit Gratis-Kontingent verwenden, nie einen mit
# hinterlegter Zahlung, und die Nutzung im Dashboard gelegentlich ansehen.
#
# Fuer den Pages-Build gehoert der Schluessel als Repository-Secret hinterlegt
# (Settings -> Secrets and variables -> Actions) und im Workflow gesetzt.
VITE_TURN_API_KEY=hier-eigenen-schluessel-eintragen
# Der Name der TURN-App beim Anbieter - er bildet den Abrufpfad
# https://<name>.metered.live/api/v1/turn/credentials
VITE_TURN_APP=holdout-turn
